  "design_goals": {
    "capabilities": {
      "value": "考察智能体能否在长时间内反复在视觉检查与假设检验之间循环：提出规则、对照全局视觉约束验证，并从静态图像中解出答案。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.16861",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.16861",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://lab.einsia.ai/visual-cipher-bench",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，语言模型智能体在 SWE-Bench Pro 与 Terminal-Bench 等编码与终端任务上已展现长程推理，但这种能力能否迁移到视觉推理仍不清楚；没有外部验证时，智能体容易在局部合理的一步后停下或过早采纳错误规则。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.16861",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.16861",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://lab.einsia.ai/visual-cipher-bench",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
