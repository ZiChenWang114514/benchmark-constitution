  "design_goals": {
    "capabilities": {
      "value": "评估大模型能否在 IT 运维中把部署历史、扩缩容规则、监控指标与文档串成一条因果链，完成故障诊断与多跳推理，而不是回忆单一事实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15718",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15718",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，可观测性平台内置的助手模型与数据都不公开、无法比较；单一准确率掩盖了模型缺失的具体能力；作者从运维落地、多实体推理、证据可追溯与推理标注等方面与已有运维基准对比。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15718",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15718",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "知识来源包括 Instana、Dynatrace、Datadog 等应用性能监控文档，云与基础设施文档，运维维基与手册（含一个内部仓库），以及 Stack Overflow 等社区论坛。在有来源记录的 2,803 道题中，2,005 道引用内部仓库，798 道引用公开页面（794 个 Stack Overflow 帖子与 4 个维基百科页面）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15718",
          "accessed": "2026-11-16"
