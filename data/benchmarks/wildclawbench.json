  "design_goals": {
    "capabilities": {
      "value": "在原生运行环境中评测智能体完成跨 shell、浏览器、文件系统与邮件的长程跨应用工作流，包括与模拟参与者多轮沟通、在模糊条件与检索预算下查证信息，以及识别提示注入、泄漏凭据与危险命令。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.10912",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/InternLM/WildClawBench",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/internlm/WildClawBench",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://www.alibabacloud.com/blog/qwen3-8-omni-flash-omni-senses--agentic-delivery-_603580",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有基准只覆盖跨模态输入、可审计轨迹、原生运行环境、双语覆盖、可复现容器与混合验证中的一部分维度；WildClawBench 同时具备这些要素。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.10912",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/InternLM/WildClawBench",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/internlm/WildClawBench",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://www.alibabacloud.com/blog/qwen3-8-omni-flash-omni-senses--agentic-delivery-_603580",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
