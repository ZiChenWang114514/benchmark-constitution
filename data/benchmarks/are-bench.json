  "design_goals": {
    "capabilities": {
      "value": "评估科研智能体能否在进行中的项目里推进一步工作，同时遵守会话中先前的决定，并正确处理工作区中未完成的文件、过时版本与失败尝试。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.14364",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.14364",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arebench.com",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，许多科研智能体基准强调独立任务和相对自足的流程，工作区干净或经整理；而研究者实际让智能体完成进行中项目的一步，请求依赖先前决定，工作区状态复杂，高分不一定转化为可靠交付。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.14364",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.14364",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arebench.com",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
