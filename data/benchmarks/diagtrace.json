      ],
      "status": "待核实"
    },
    "quality_control": {
      "value": "来源事件须有报告文本依据，并控制泄漏。两名标注者审核了 52 个互异抽取事件，论文报告 48 条标签一致（92.3%），Cohen κ 为 0.874，加权 κ 为 0.925；在与 GPT-4.1 mini 审核重叠的 20 个事件上，分别有 18/20 与 20/20 的判断一致。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22009",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22009",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/Fanncg1229/Diagtrace",
          "accessed": "2026-11-19"
        }
      ]
    },
    "decontamination": {
      "value": "构建时要求标记会泄露诊断的内容并作保护处理；交互实验使用单独的匹配与全量交互回合。因临床智能体被给予最终诊断，分数衡量的是轨迹重建而非自主诊断能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22009",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22009",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/Fanncg1229/Diagtrace",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
