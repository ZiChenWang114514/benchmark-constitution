  "design_goals": {
    "capabilities": {
      "value": "在给定正确诊断的前提下，考察模型能否通过多轮交互主动获取信息，重建与文献来源一致的诊断轨迹，而不是在信息一次给全的静态设置中只预测最终诊断。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22009",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22009",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/Fanncg1229/Diagtrace",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有医学问答和诊断推理评测通常预先提供全部患者信息，并主要看最终诊断或对话质量，较少系统考察模型能否在信息不完整时、在恰当时间请求恰当证据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22009",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22009",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/Fanncg1229/Diagtrace",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "每条实例由 PubMed Central 病例报告构建，包含初始表现、有来源顺序的事件库、临床病程和诊断参考文献。全文共 510 例，覆盖八个专科；事件库平均含 11.59 个来源事件。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22009",
          "accessed": "2026-11-19"
        },
