        }
      ],
      "status": "待核实"
    },
    "quality_control": {
      "value": "用大语言模型审阅去除规则含糊或结果难以核验的问题；选择时平衡期限与领域。评测前，论文还用该批次检验搜索来源差异、证据随时间变化，以及页面日期能否界定当时可知信息。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.23045",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.23045",
          "accessed": "2026-11-19"
        }
      ]
    },
    "decontamination": {
      "value": "证据在问题仍未结算时前瞻采集并冻结，从而在构造上当时可知。论文报告，事后用同一查询再检索时，即便使用受测日期过滤，仍可能出现几乎直接披露结局的结果，比例最高可达问题的 92%。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.23045",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.23045",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
