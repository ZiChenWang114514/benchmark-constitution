  "design_goals": {
    "capabilities": {
      "value": "在相同的前瞻性记录证据轨迹上，比较不同模型、记忆策略与搜索来源的预测能力；考察智能体能否依据当时可获得的检索结果给出概率预测，并随证据更新修订判断。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.23045",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.23045",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，实时评测会把检索与推理缠在一起；事后用日期过滤或今日排序重建历史检索，可能泄漏结算后的信息。已有基准难以同时满足实时采集、固定证据、多状态可重放，以及在同一轨迹上比较搜索来源。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.23045",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.23045",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "题目取自 Polymarket 与 Kalshi 上仍开放的二元预测市场问题，要求在 14 天内收盘。筛选会去掉价格低于 10% 或高于 90%、或 48 小时内收盘的市场；再用大语言模型审阅去掉规则含糊或结果难以核验的问题，并按期限、领域做配额平衡，覆盖六个领域。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.23045",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.23045",
          "accessed": "2026-11-19"
        }
      ]
    },
