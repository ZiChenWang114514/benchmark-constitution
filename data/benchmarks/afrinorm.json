  "design_goals": {
    "capabilities": {
      "value": "考察大语言模型在非洲社会文化语境中的规范推理，即对应当做与不应当做的义务、许可和禁忌的判断，而不只是语言流利度或一般习俗知识。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22580",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22580",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，现有非洲自然语言处理基准多测语言能力或领域知识，BLEND 等文化基准主要覆盖人们通常怎么做的社会习俗，而较少测道义情态，即规范与禁忌。SocialIQA 采用情景问答，但限于英语且缺少非洲文化特异性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22580",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22580",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "当前发布是针对约鲁巴文化的案例研究，问题由目标文化的本地专家根据真实社会情景编写，并配有平行的英语与约鲁巴语版本。构造流程计划扩展到另外 20 种非洲语言。选项按三步生成：正确的文化规范答案、去掉文化线索后由主流大语言模型给出的常识默认答案，以及对抗性文化干扰项。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22580",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22580",
          "accessed": "2026-11-19"
        }
      ]
    },
