  "design_goals": {
    "capabilities": {
      "value": "模拟病理医生整合同一病变多个视野（由低倍到高倍）作出病例级诊断的过程，分别考察诊断、分诊、分级、形态学所见核实与所见定位。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15325",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15325",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/Wenchuan-Zhang/CaseScope",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有病理视觉问答多针对单张图像；跨尺度基准只展示同一张 TCGA 切片的两三个嵌套区域并用大模型生成问题；通用多图基准考的是一般跨图关系，而非专家证据整合。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15325",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15325",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/Wenchuan-Zhang/CaseScope",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
