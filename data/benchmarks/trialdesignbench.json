  "design_goals": {
    "capabilities": {
      "value": "根据试验的临床信息，为早期肿瘤剂量探索试验推荐合适的统计设计方法（如 BOIN、3+3、CRM），并检验信息丰富程度与专家设计原则对推荐质量的影响。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12640",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12640",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/hanktang-research/TrialDesignBench",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文称这是首个面向人工智能辅助临床试验统计设计推荐的基准；统计设计会显著影响评估准确性与所需患者数，进而影响研发周期、成本与成功率。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12640",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12640",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/hanktang-research/TrialDesignBench",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
