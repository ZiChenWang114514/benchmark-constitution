  "design_goals": {
    "capabilities": {
      "value": "考察作为“数字同事”的智能体能否在分散于 Slack 频道、在线文档、代码提交、源文件与实验输出中的项目状态里检索、核实与推断，并在问题无法回答或前提错误时拒答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.05512",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.05512",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/HuanzhiMao/SlackBench",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，现实项目状态分散在多个平台并随时间演变，而已有基准多以单一来源为主；作者以隐私保护的人机协作模拟重建科研项目历史，避免公开真实的组织聊天记录。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.05512",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.05512",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/HuanzhiMao/SlackBench",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
