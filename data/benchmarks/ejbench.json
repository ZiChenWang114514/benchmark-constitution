  "design_goals": {
    "capabilities": {
      "value": "考察模型能否依据少量已完成工况的结果，判断新工况下的设计行为并作出决策，包括把未标记测试结果匹配到运行条件、在签核前选择应揭示的存档工况，以及按峰值电芯温度给新负荷排序。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.21707",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/GradientDynamics/EJBench",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，许多工程基准来自教材或考试，或只测试能否操作仿真与计算机辅助设计软件；可运行并不等于判断正确。EJBench 不依赖特定软件，而问工程师在不重新仿真时会得出什么结论。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.21707",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/GradientDynamics/EJBench",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "题目来自电池冷板共轭传热设计实验。每个答案取自收敛且通过质量、流量与能量平衡检查的仿真，而非由大模型评判。划分按几何进行，同一设计及其工况只落在一个划分中。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.21707",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/GradientDynamics/EJBench",
          "accessed": "2026-11-19"
        }
      ]
    },
