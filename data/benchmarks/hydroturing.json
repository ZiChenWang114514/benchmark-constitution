  "design_goals": {
    "capabilities": {
      "value": "把物理定律当作测试套件：检验水文模型（含人工智能模型与过程模型）在生成的隐藏工况下是否守恒质量、能量与动量。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.11563",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.11563",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/Flood-Lab/HydroTuring",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://flood-lab.github.io/HydroTuring/",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，人工智能科学基准多报告在公开数据上的精度；据作者所知，水文或地球系统科学中尚无在隐藏的生成工况上检验守恒定律的基准，而水量平衡闭合很少以可比形式报告，模型不开源时更无从得知。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.11563",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.11563",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/Flood-Lab/HydroTuring",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://flood-lab.github.io/HydroTuring/",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
