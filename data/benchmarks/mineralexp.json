  "design_goals": {
    "capabilities": {
      "value": "在给定地质假设与初始上下文时，考察智能体能否选择相关的科学任务并生成具体实验方案，以在投入昂贵实验室工作之前检验地质假说，并用多标签分类指标和由大模型评判的证据覆盖指标评分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17931",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/wangbing1416/MineralExp",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://wangbing1416.github.io/projects/mineralexp",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，大语言模型智能体已较多用于下游地球科学数据分析，但上游的地球化学实验设计，也就是在进实验室前决定做哪些实验，仍缺少评测。同一假说可对应多种合理实验方案，开放式计划也难以写成单一标准答案。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17931",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/wangbing1416/MineralExp",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://wangbing1416.github.io/projects/mineralexp",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "由已发表矿床文献构建，并经领域专家审核。taxonomy 将实验映射到矿床系统五类过程（物源、搬运、沉淀、改造、保存）和 19 类科学任务，从而得到确定性的多标签目标，同时容纳方法多样性。构建中曾有 353 项候选研究，并排除 54 条不完整记录。",
      "sources": [
