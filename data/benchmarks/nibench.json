  "design_goals": {
    "capabilities": {
      "value": "在真实神经影像数据与工具链上，考察自主智能体能否执行和重建分析工作流、把执行经验蒸馏成可复用技能并迁移，以及能否依据原始队列数据得出有证据支持的科学结论。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15831",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15831",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有研究多集中于科学问答和基于工具的自动化，对工作流重建、程序性专长的获取以及基于证据的科学判断缺乏系统证据；在神经影像中，看似合理的分析结果可能掩盖影响结论的错误。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15831",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15831",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "工作流任务覆盖七个工具生态，涉及结构、弥散与功能磁共振、正电子发射断层扫描及多模态分析；科学判断部分取自三项已发表的阿尔茨海默病研究（纵向认知变化、tau 沉积轨迹与疾病进展），共 36 条论断，智能体需分析未经筛选的 ADNI 表格。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15831",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15831",
