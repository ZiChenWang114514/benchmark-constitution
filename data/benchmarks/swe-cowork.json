  "design_goals": {
    "capabilities": {
      "value": "考察编码智能体能否在模拟工程组织中，从简短交接出发，向同事和职场记录收集分散的需求、调和冲突证据，并提交由私有可执行测试检验的代码改动，从而完成完整交付而非仅实现部分行为。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.20218",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.20218",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://tokenwave-ai.github.io/swe-cowork-page",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/TokenWave-AI/swe-cowork-bench",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/Tokenwave-AI/swe-cowork",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，现有编码基准多评测孤立、预先限定的任务描述；关于信息不足的研究或改变初始请求中的信息，或允许询问掌握缺失需求的指定模拟用户。因此智能体往往仍是规范执行者，而不是需要在组织中主动澄清、核对记录并跟踪需求的数字工程师。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.20218",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.20218",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://tokenwave-ai.github.io/swe-cowork-page",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/TokenWave-AI/swe-cowork-bench",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/Tokenwave-AI/swe-cowork",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "101 项开发任务来自 101 个上游真实开源仓库，覆盖 11 种程序语言和 12 个应用领域，包括网络框架、编译器、游戏、支付与科学软件。每个仓库配有由 26 名被建模同事组成的组织，101 项任务共 2,626 份员工档案。需求分布在同事与职场记录中；交接说明给出目标、测试修改限制、相邻项目不在范围内，以及可能与当前仓库不一致的历史术语。",
      "sources": [
