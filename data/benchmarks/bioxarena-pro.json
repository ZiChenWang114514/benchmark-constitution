  "design_goals": {
    "capabilities": {
      "value": "让智能体在一块 GPU、两小时预算内，从训练数据和未标注测试输入出发端到端构建模型并提交预测，检验其在真实研究级生物医学数据上的留出表现是否反映真实建模能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.13994",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.13994",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/mbzuai-ai4bio/BioXArena-Pro",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/mbzuai-ai4bio/BioXArena-Pro-Public",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，多数科学与生物医学智能体基准考的是知识、工具使用或分析过程，而非端到端建模；已有建模基准规模小、来自竞赛或只含干净表格与随机划分。作者此前的 BioXArena（9 个领域 76 项任务）已接近饱和，两个最强配置平均已达 66 分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.13994",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.13994",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/mbzuai-ai4bio/BioXArena-Pro",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/mbzuai-ai4bio/BioXArena-Pro-Public",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "每项任务复现一篇已发表研究或数据库中的研究级建模问题，保留原研究的分布偏移、数据量与原生格式；每项任务都给出已发表方法的复现参考（33 项为该数据集的方法，31 项为同类问题最强方法）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.13994",
