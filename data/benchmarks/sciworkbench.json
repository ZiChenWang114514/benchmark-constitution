  "design_goals": {
    "capabilities": {
      "value": "考察智能体能否在接近真实实验室分析的工作流中，围绕假设、原始实验数据、数据整理、初步与深入分析、建模或预测、科学结论与迭代修正等环节作出有证据支持的判断，而不只是完成单步计算或静态问答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22490",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22490",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有科学基准多只覆盖知识问答、可执行程序生成、领域分析或预定义工具使用等局部环节，缺少在原始或不完美数据、不确定性与伪迹上，把实验证据推进到可辩护结论的工作流级评测。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22490",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22490",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
