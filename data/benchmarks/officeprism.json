  "design_goals": {
    "capabilities": {
      "value": "考察智能体能否在单一业务职能内完成封闭的企业操作，并比较同一职能内按基准定义的 L1 至 L3 任务结构下的表现，从而在跨职能协调之前先定位单域能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22262",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22262",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/Leozyu/OfficePrism",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，宽泛的职场总分会把同一职能内的能力与跨职能、跨系统协调的额外代价混在一起，使失败难以定位。已有企业基准提供可执行环境或可扩展构造流程；OfficePrism 的补充是把每项任务限制在一个业务职能内，并在各职能使用同一套任务结构定义。本条目须与已有的 OfficeBench、OfficeQA 以及生物医学领域的 PRISM 区分，不得合并。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22262",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22262",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/Leozyu/OfficePrism",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "每项任务运行在新的任务局部环境中，该环境由共享的合成组织与七个业务职能之一组成，并通过类型化工具访问状态。共享组织有 75 名员工（其中 63 人在职）、12 个部门、22 个团队。七个职能及任务数为：行政管理 56、财务 58、人力资源 60、信息技术 60、法务 76、采购 55、项目工作 55。智能体看到的是调用者上下文和中文自然语言工单。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22262",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22262",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/Leozyu/OfficePrism",
          "accessed": "2026-11-19"
        }
      ]
    },
