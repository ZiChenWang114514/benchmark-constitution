  "data_format": {
    "size": {
      "value": "OfficePrism-420 含 420 项任务：105 项 L1、140 项 L2、175 项 L3。每个职能贡献 15 项 L1 和 20 项 L2，保留的 L3 数量为 20 至 41。参考见证的调用次数在 L1、L2、L3 上分别为 1–4、2–7、4–16，中位数为 1、3、7。任务局部环境含 42–61 个顶层集合、4,701–17,126 条记录、135–198 个原生函数。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22262",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22262",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/Leozyu/OfficePrism",
          "accessed": "2026-11-19"
        }
      ]
    },
