  "design_goals": {
    "capabilities": {
      "value": "检验机器学习代理模型对三维湍流的动态预报能力：在稠密不规则网格上的长时自回归推演稳定性、高频湍流特征的保持，以及跨几何与流动条件的泛化。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.09567",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.09567",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/itsakk/TurtLES",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/turtlesprojectml/turtles",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，许多被称为动态流体的基准其实是非定常层流、二维混沌系统，或由浮力、辐射强迫、磁效应主导的三维动力学；常规误差指标掩盖了这种差别，只有能谱、脉动统计与流态转变行为才能显现。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.09567",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.09567",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/itsakk/TurtLES",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/turtlesprojectml/turtles",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
