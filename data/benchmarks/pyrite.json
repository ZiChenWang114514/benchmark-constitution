  "design_goals": {
    "capabilities": {
      "value": "给定同一蛋白质-配体复合物的两个预测结合构象，判断哪个更接近晶体结构中的真实结合模式；考察语言模型智能体能否在与化学家相同的计算工具输出上推理，排得比工具本身或专家更准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.14511",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.14511",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/genesistherapeutics/pyrite",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/genesisml/pyrite",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有将语言模型智能体与物理化学工具结合排序经典对接构象的工作，只在小型基准上与底层打分函数持平而未超越；共折叠模型能给出许多看似合理的结合模式，判别其优劣仍缺乏有挑战性的评测。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.14511",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.14511",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/genesistherapeutics/pyrite",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/genesisml/pyrite",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
  "construction": {
