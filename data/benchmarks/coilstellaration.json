  "design_goals": {
    "capabilities": {
      "value": "给定目标等离子体边界与一组工程要求，模型能否一次前向推理直接生成可工程化的线圈组，同时满足磁场精度与几何约束。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12689",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12689",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/proximafusion/coilstellaration",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/proxima-fusion/coilstellaration",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文介绍，已有的 QUASR 库收录近 37 万个准轴对称与准螺旋对称装置及其线圈；CoilStellaration 面向条件线圈生成，系统探索不同纵横比、旋转变换与线圈长度下工程要求与磁场精度之间的权衡。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12689",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12689",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/proximafusion/coilstellaration",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/proxima-fusion/coilstellaration",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
