  "design_goals": {
    "capabilities": {
      "value": "在 LSST、Euclid 与 Roman 三个巡天配置之间，由已观测模态补全缺失巡天的观测，并以下游强透镜分类检验补全结果的科学可用性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04139",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.04139",
