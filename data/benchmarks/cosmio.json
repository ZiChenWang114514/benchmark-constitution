        },
        {
          "url": "https://github.com/fw-ic/COSMIO",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://www.kaggle.com/datasets/cosmidata/cosmio",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，为最成熟的缺失模态补全场景（多对比度脑磁共振）开发的方法迁移到天文巡天数据效果差，常被更简单的方法超越；地基 LSST 受大气视宁度影响，分辨率受点扩散函数限制、噪声多变。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04139",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.04139",
