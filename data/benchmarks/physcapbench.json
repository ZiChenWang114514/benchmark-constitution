  "design_goals": {
    "capabilities": {
      "value": "评估视频描述能否准确、完整地记录物体运动、交互与状态演变等物理信息，以服务世界模型预训练与操作策略学习。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.16424",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.16424",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://hfwang2001.github.io/physcapbench-site/",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为已有视频描述评测较少聚焦物理内容，也未同时覆盖第三人称场景、第一人称人类操作与手持夹爪多视角演示；作者称其为首个统一覆盖这三个领域的物理描述基准。另有一项 Physis-Lang 工作也以 PhysCapBench 命名，二者为不同基准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.16424",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.16424",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://hfwang2001.github.io/physcapbench-site/",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "第三人称视频覆盖 8 个主要物理类别与 16 个场景类别；第一人称视频取自 EgoDex，覆盖 118 项任务（每项 4 至 5 段）、15 个场景组，含 RGB 与手部追踪，约 2.21 小时；第三个领域为手持夹爪多视角演示。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.16424",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.16424",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://hfwang2001.github.io/physcapbench-site/",
          "accessed": "2026-11-16"
        }
      ]
    },
