  "design_goals": {
    "capabilities": {
      "value": "检验代理模型能否以相近精度预测全部耦合物理场（尤其是速度场），以及短窗口精度能否在自主长时推演中保持。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04517",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.04517",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/irenier/GeoSim",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，代理模型可能准确复现缓变的标量场却抓不住系统运动，短时精度也未必能在自主推演中保持；WeatherBench 与 ClimSim 等面向天气与气候，地球动力学多场算子学习缺少对应基准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04517",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.04517",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/irenier/GeoSim",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
