          "url": "https://arxiv.org/pdf/2611.22514",
          "accessed": "2026-11-19"
        }
      ],
      "status": "待核实"
    },
    "review_process": {
      "value": "表由人工审阅；参考报告经蒙特卡洛树搜索生成候选后由人类专家策划与验证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22514",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22514",
          "accessed": "2026-11-19"
        }
      ]
    },
    "quality_control": {
      "value": "所有表经过人工审阅，去除个人身份信息并确认有足够定量深度。参考报告先由蒙特卡洛树搜索在多维奖励下生成候选，再由人类专家策划与修订。任务配有人类撰写的参考，指定预期章节结构和可验证的关键洞察点。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22514",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22514",
          "accessed": "2026-11-19"
        }
      ]
    },
