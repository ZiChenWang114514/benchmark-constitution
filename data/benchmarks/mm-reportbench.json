  "design_goals": {
    "capabilities": {
      "value": "考察模型能否根据一张或多张结构化表和自然语言分析指令，生成把叙述与忠实可视化结合在一起的多模态报告，包括结构化章节和嵌入文中、有表格证据支持的图表。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22514",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22514",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，已有表格理解基准多关注问答等较窄任务；表格到报告的工作往往分开评文本与视觉，或忽略视觉输出。LLM 评委虽可扩展，但单一评委可能被跨模态补偿欺骗，并抬高总分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22514",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22514",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "185 张真实商业表来自市政开放数据、行业协会报告、公司年报和开源表格数据，遵循 T2R-Bench 的协议，覆盖金融、制造、医疗、教育、零售和信息技术运维六个领域。其中 38 张表超过 5 万个单元格（占 20.5%），复杂表头占 32.4%。查询用基于模板的自我指令生成，覆盖趋势分析、比较、排序、异常、构成、相关、预测、细分、同比和跨维度等场景，再经人工挑选。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22514",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.22514",
          "accessed": "2026-11-19"
        }
      ]
    },
    "author_background": {
      "value": "待核实",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.22514",
          "accessed": "2026-11-19"
        },
