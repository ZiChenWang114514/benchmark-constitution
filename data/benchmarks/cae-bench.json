  "design_goals": {
    "capabilities": {
      "value": "考察智能体能否只利用少量公开工况开发可复用的计算机辅助工程求解器，并在几何、材料、初值或边界条件不同的留出工况上泛化，而不是只为固定输入写出一次性求解程序。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.21273",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/AXeonV/CAE-Bench",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，已有基准多评估在给定问题或给定输入上开发数值求解器或完成仿真；工业级求解器必须在开发阶段看不到的多种输入上复用。若输入在开发时已知，智能体甚至可能记住答案。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.21273",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/AXeonV/CAE-Bench",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "RC7 含 80 项计算任务：13 项给定方程的偏微分方程任务、43 项流体力学任务，以及 24 项改编自 CFDCodeBench 的固定问题（无留出工况，单独报告）。参考结果来自解析解、已有数据集和成熟仿真软件。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.21273",
