  "design_goals": {
    "capabilities": {
      "value": "从晶体结构预测完整包含自旋轨道耦合的复数厄米电子哈密顿量，并检验预测的哈密顿量能否支撑能带、带隙与态密度等下游电子性质计算。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12509",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12509",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/WendyYW/UniHam",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有哈密顿量数据集普遍缺少对自旋轨道耦合的系统纳入；HamGNN 报告的约 4.4 万结构数据未公开。UniHam 规模是次大公开自旋轨道耦合数据集的 6 倍，也是唯一覆盖镧系 4f 元素、带系统分布外评测与规范校正多层指标的基准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12509",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12509",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/WendyYW/UniHam",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
