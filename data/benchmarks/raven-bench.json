  "design_goals": {
    "capabilities": {
      "value": "考察模型能否在低空配对光电–红外视频上，依据小、短、且可能只出现在单一传感器中的证据，完成目标中心的接地、时序–空间推理和模态感知的事件推理，并区分配对输入相对更强单模态的增益、单模态依赖、目标一致性和证据链连贯性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.18880",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/yuhu990424/RAVEN-Bench",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/TerraSenseAnalytics/RAVEN-Bench",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，已有视频基准多用自然可见光视频，遥感视觉–语言评测多针对静态图像，光电–红外数据集则多用于检测、跟踪或分割；缺少在配对光电–红外航空视频上、以语言为接口的推理评测。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.18880",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/yuhu990424/RAVEN-Bench",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/TerraSenseAnalytics/RAVEN-Bench",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "100 对时间对齐的光电–红外视频，每对 12 道题，共 1,200 道人工撰写的四选一问题。每个样本围绕一个目标中心航空事件。全部视频来自同一架飞机、同一光电/红外云台，以及北美西部的同一区域。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.18880",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/yuhu990424/RAVEN-Bench",
