  "design_goals": {
    "capabilities": {
      "value": "给定稀疏采样的解数据，智能体要先从有限方程库中识别未知方程族并拟合系数（含分数阶参数），再写出能在整个区域上精确求解的程序，并在固定预算内通过反馈迭代改进求解器。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.14949",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.14949",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/jeremylu916/RSI-PDE",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/JeremyLu1017/PDE-RSI",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，同时隐藏方程族与系数，比把完全给定的方程翻译成代码更难；可执行代码本身不能证明科学上的准确性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.14949",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.14949",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://github.com/jeremylu916/RSI-PDE",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://huggingface.co/datasets/JeremyLu1017/PDE-RSI",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "以经典与分数阶偏微分方程模板为基础生成案例：20 个经典与分数阶模板、10 个非线性或多物理模板、12 个数据驱动或附加维度模板；参考解为解析解或经收敛检验的高精度数值解。",
