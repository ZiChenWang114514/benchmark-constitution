  "design_goals": {
    "capabilities": {
      "value": "在完整的大场景合成孔径雷达图像上，同时考察全局语义理解与细粒度小目标感知，任务覆盖场景解译、区域感知、目标理解、视觉定位、详细描述和条件计数。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.19364",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/Jiaqikiki/XLSAR",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有合成孔径雷达视觉–语言基准多用小图块或目标中心样本，难以同时评估完整大场景理解与小目标细节；部分自动标注还可能引入无视觉依据的属性或语言偏差。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.19364",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/Jiaqikiki/XLSAR",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从 11 个合成孔径雷达数据源收集 405 张图像，长边约 2,000 至 40,000 像素，平均 7,153×7,153。标注来自已有空间标签并对照原始图像核验；描述由半自动描述器生成后再经细致人工标注。评测为中英双语。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.19364",
          "accessed": "2026-11-19"
        },
