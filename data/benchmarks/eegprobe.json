  "design_goals": {
    "capabilities": {
      "value": "考察通用视觉–语言模型能否在不做任务特定特征工程或脑电专用适配的前提下，从最少预处理的通道级脑电中提取信息并完成分类、跨模态对齐与神经生理推理。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.20779",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/2122ZHU/EEGProbe",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，已有脑电系统多为单一任务而设计，视觉–语言模型在图像与文本上的能力是否延伸到电生理信号仍不清楚；EEGProbe 强调保留时间结构并降低基准引入的加工，以避免捷径作答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.20779",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://huggingface.co/datasets/2122ZHU/EEGProbe",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
