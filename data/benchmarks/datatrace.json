  "design_goals": {
    "capabilities": {
      "value": "考察数据智能体能否在数据库产物的类型化血缘图上定位被注入的单一故障根因，并检查其是否查阅了把可见症状连接到该根因的证据路径，从而区分有依据的诊断与缺乏证据的碰巧答对。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.18926",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.18926",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://hkustdial.github.io/datatrace/",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有基准通常只评最终查询或最终答案，无法区分基于证据的诊断与没有查阅必要产物却答对的情况。数据管道可以在不报错的情况下给出错误结果，而显式报错也不标出上游根因。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.18926",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.18926",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://hkustdial.github.io/datatrace/",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "83 个数据工程环境来自五个源家族：BIRD-CRITIC、Spider2、dbt 仓库、采集的生产事故和合成场景，并跨越九个行业部门。生成器通过 21 种类型化故障算子注入故障、从可复现的公开仓库提交中挖掘事故，或可选地从图游走反向生成开放问题（开放问题没有机械见证路径，不进入冻结榜）。冻结榜使用其中 64 项任务、9 种算子和 13 个环境（3 个本地 DuckDB 项目与 10 个源自 BIRD 的数据库）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.18926",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.18926",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://hkustdial.github.io/datatrace/",
          "accessed": "2026-11-19"
        }
      ]
