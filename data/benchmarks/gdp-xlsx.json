  "design_goals": {
    "capabilities": {
      "value": "考察语言智能体在完整工作簿或 CSV 上回答同事式专业请求的能力：在文件中定位权威证据、对集合答案做到完整且不多余，并阅读由格式、批注、筛选或嵌入对象承载的结构信息。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17766",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17766",
