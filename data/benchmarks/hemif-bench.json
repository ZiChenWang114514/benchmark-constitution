  "design_goals": {
    "capabilities": {
      "value": "考察苏木精–伊红到多重免疫荧光生成器的内部编码器特征与生成输出，能否在分子、细胞、组织和患者尺度的下游任务上提供效用，包括外部 CD3 恢复、单细胞分类、致密核分割、三级淋巴结构与生发中心分割，以及患者生存预测，并与冻结的 UNI2 对照。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.19905",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.19905",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有虚拟染色研究主要看与实测蛋白信号的像素级相关，近期基准也只覆盖部分下游应用；仅评估生成输出，无法判断翻译是否得到强于纯苏木精–伊红基础模型的内部特征，以及生成输出是否保留了这些特征中的预测信号。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.19905",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://arxiv.org/pdf/2611.19905",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "五项任务、八个公开数据集：Cell-niches 上的外部 CD3 恢复，Immunocto 与 NuCLS 上的单细胞分类，PathoCell 与 Lizard 上的致密核分割，HookNet-TLS 上的三级淋巴结构与生发中心分割，以及 TCGA-COAD 与 TCGA-LUAD 上的生存预测。五个已公开的生成器被冻结评测。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.19905",
          "accessed": "2026-11-19"
