  "design_goals": {
    "capabilities": {
      "value": "按三类医疗角色（患者与公众、医疗专业人员、医疗卫生行政专业人员）与三类人工智能能力（知识、推理、行动）组织评测，并用 InclusionMed Index 汇总模型在首发五个基准上的表现，同时报告角色与能力分项以及估测推理成本。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.21218",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://inclusionmed.ai/",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/panuvi/inclusionmed",
          "accessed": "2026-11-19"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，推进包容性医疗人工智能需要覆盖多样角色、任务与照护场景，但现有基准覆盖不均；部分候选因分数饱和或区分度不足而未纳入本轮指数。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.21218",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://inclusionmed.ai/",
          "accessed": "2026-11-19"
        },
        {
          "url": "https://github.com/panuvi/inclusionmed",
          "accessed": "2026-11-19"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "在 388 个候选中经结构化审核与独立复现选出四个公开基准：HealthBench Professional、PhysicianBench、ALE-CLI v1.0 的 Health and Medicine 子集，以及 CHI-Bench；再加入私有诊断推理基准 InclusionMed-DxFiles。图 1 标明各基准对应的角色–能力格子，每个基准对总分贡献 20%。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.21218",
