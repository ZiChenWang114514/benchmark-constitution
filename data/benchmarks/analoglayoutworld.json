  "design_goals": {
    "capabilities": {
      "value": "考察编码智能体能否把固定的晶体管级网表变成器件布局与互连，并借助验证反馈迭代改进，完成端到端的模拟电路版图设计。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.16991",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.16991",
          "accessed": "2026-11-16"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，集成电路领域的智能体基准多集中于数字设计，从功能验证的寄存器传输级代码生成到负载到版图的流程；模拟版图需要领域知识与几何推理，并依赖反复验证，缺少开放的端到端评测。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.16991",
          "accessed": "2026-11-16"
        },
        {
          "url": "https://arxiv.org/pdf/2611.16991",
          "accessed": "2026-11-16"
        }
      ]
    }
  },
