---
import '../styles/global.css';
import '../styles/polish.css';
import '../styles/tables.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { currentLocale, hrefForLocale, t } from '../i18n';

interface Props {
  title: string;
  description: string;
  active?: 'home' | 'trending' | 'heat' | 'impact' | 'registry' | 'constitution' | 'api' | 'search';
  readingProgress?: boolean;
}
const { title, description, active, readingProgress = false } = Astro.props;
const locale = currentLocale();
const fullTitle = title === 'Benchmark Constitution' ? 'Benchmark Constitution' : `${title} — Benchmark Constitution`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const enHref = new URL(hrefForLocale(Astro.url.pathname, '', 'en'), Astro.site).href;
const zhHref = new URL(hrefForLocale(Astro.url.pathname, '', 'zh'), Astro.site).href;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-Hans' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="zh-Hans" href={zhHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151411" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var meta = document.querySelector('meta[name="color-scheme"]');
        if (!meta) return;
        var saved = null;
        try { saved = localStorage.getItem('bc-theme'); } catch (error) { saved = null; }
        if (saved === 'light' || saved === 'dark') {
          meta.setAttribute('content', saved);
          document.documentElement.dataset.theme = saved;
        }
      })();
    </script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,500&family=Noto+Sans+SC:wght@400;500;600&family=Noto+Serif+SC:wght@500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    {readingProgress && <div class="scroll-progress" aria-hidden="true"></div>}
    <a class="skip" href="#content">{t(locale, 'skip')}</a>
    <Header active={active} />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <script>
      import { mountNameReveal } from '../scripts/name-reveal.ts';
      mountNameReveal();
    </script>
    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        document.addEventListener('click', function (event) {
          var target = event.target;
          var btn = target && target.closest ? target.closest('[data-copy-btn]') : null;
          if (!btn) return;
          var value = btn.getAttribute('data-copy-value') || '';
          if (!value) {
            var refId = btn.getAttribute('commandfor') || btn.getAttribute('data-copy-for');
            var ref = refId ? document.getElementById(refId) : null;
            value = ref ? (ref.textContent || '').trim() : '';
          }
          if (!value || !navigator.clipboard || !navigator.clipboard.writeText) return;
          var baseLabel = btn.getAttribute('data-label') || btn.textContent || '';
          var copiedLabel = btn.getAttribute('data-copied') || 'Copied';
          var statusId = btn.getAttribute('data-copy-status');
          var live = statusId ? document.getElementById(statusId) : null;
          navigator.clipboard.writeText(value).then(function () {
            btn.textContent = copiedLabel;
            btn.classList.add('is-copied');
            if (live) live.textContent = copiedLabel;
            window.setTimeout(function () {
              btn.textContent = baseLabel;
              btn.classList.remove('is-copied');
              if (live) live.textContent = '';
            }, 1800);
          }).catch(function () {});
        });
      })();
      (function () {
        var reduce = false;
        try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (error) { reduce = false; }
        var nodes = Array.prototype.slice.call(document.querySelectorAll('.reveal, .grow-root'));
        function arm(node) { node.classList.add('inview'); }
        if (reduce || !nodes.length) {
          for (var i = 0; i < nodes.length; i += 1) arm(nodes[i]);
          return;
        }
        var below = [];
        for (var j = 0; j < nodes.length; j += 1) {
          var rect = nodes[j].getBoundingClientRect();
          var seen = rect.height > 0 && rect.bottom > 0 && rect.top < window.innerHeight;
          if (seen || reduce) arm(nodes[j]);
          else {
            nodes[j].classList.add('pending');
            below.push(nodes[j]);
          }
        }
        if (!below.length || !('IntersectionObserver' in window)) {
          for (var n = 0; n < below.length; n += 1) arm(below[n]);
          return;
        }
        document.documentElement.classList.add('motion');
        var observer = new IntersectionObserver(function (entries) {
          for (var n = 0; n < entries.length; n += 1) {
            if (!entries[n].isIntersecting) continue;
            arm(entries[n].target);
            observer.unobserve(entries[n].target);
          }
        }, { rootMargin: '80px 0px', threshold: 0 });
        for (var k = 0; k < below.length; k += 1) observer.observe(below[k]);
      })();
    </script>
  </body>
</html>
