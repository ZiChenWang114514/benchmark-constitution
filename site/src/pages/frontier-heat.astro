---
import Base from '../layouts/Base.astro';
import { currentLocale, t } from '../i18n';
import { translateContent } from '../i18n/content';
import { visualCopy } from '../i18n/visual';
import { sectionLabel, sectionSlug } from '../lib/sections';
import { loadHeat, rankArrow } from '../lib/boards';
import { loadIndex } from '../lib/data';
import { asset, dateStamp, displayName, page, safeUrl, sectionStyle } from '../lib/format';
import { resolveModelTheme, resolveOrgTheme } from '../lib/models';
import BarChart from '../components/BarChart.astro';
import BrandLogo from '../components/BrandLogo.astro';

const locale = currentLocale();
const ui = visualCopy(locale);
const heat = loadHeat();
const known = new Set(loadIndex().benchmarks.map((item) => item.id));
const modelName = new Map((heat?.models ?? []).map((model) => [model.id, model.name]));
const stamp = dateStamp(heat?.generated_at);
const domains = [...new Set((heat?.ranking ?? []).map((row) => row.domain).filter((domain): domain is string => !!domain))].sort((a, b) => a.localeCompare(b, 'zh'));
const showSpark = (heat?.history?.length ?? 0) >= 2;
const showMovement = Boolean(heat?.coverage?.rank_change_reference_date)
  || (heat?.ranking ?? []).some((row) => typeof row.rank_change === 'number');

const movers = (() => {
  const history = heat?.history ?? [];
  if (history.length < 2) return [];
  const prev = new Map(history[history.length - 2].top.map((id, index) => [id, index + 1]));
  const last = history[history.length - 1].top;
  return last
    .map((id, index) => {
      const before = prev.get(id);
      const now = index + 1;
      return { id, name: heat?.ranking.find((row) => row.benchmark_id === id)?.name ?? id, delta: before == null ? null : before - now };
    })
    .filter((row) => row.delta != null && row.delta > 0)
    .sort((a, b) => (b.delta ?? 0) - (a.delta ?? 0))
    .slice(0, 5);
})();

const heatChart = (heat?.ranking ?? []).slice(0, 12).map((row) => ({
  rank: row.rank,
  name: displayName(row.name),
  value: row.count,
  href: known.has(row.benchmark_id) ? page('benchmarks/' + row.benchmark_id) : page('frontier-heat'),
  models: (row.models ?? []).map((id) => {
    const label = modelName.get(id) ?? id;
    const theme = resolveModelTheme(id);
    return { name: label, theme };
  }),
}));
const nf = new Intl.NumberFormat(locale === 'zh' ? 'zh-Hans' : 'en');
const totalMentions = (heat?.ranking ?? []).reduce((sum, row) => sum + row.count, 0);
const topRow = heat?.ranking?.[0];
const orgCounts = (() => {
  const counts = new Map<string, number>();
  for (const model of heat?.models ?? []) {
    const org = model.organization || '';
    if (org) counts.set(org, (counts.get(org) ?? 0) + 1);
  }
  return [...counts].sort((a, b) => b[1] - a[1]);
})();
const namedMax = Math.max(1, ...(heat?.models ?? []).map((model) => model.benchmarks?.length ?? 0));
const history = heat?.history ?? [];
const formHistory = history.slice(-6);
function formOf(id: string): { date: string; rank: number | null }[] {
  return formHistory.map((entry) => {
    const place = entry.top.indexOf(id);
    return { date: entry.date, rank: place === -1 ? null : place + 1 };
  });
}
function formTier(rank: number | null): string {
  if (rank == null) return 'form-out';
  if (rank <= 3) return 'form-1';
  if (rank <= 10) return 'form-2';
  if (rank <= 25) return 'form-3';
  if (rank <= 60) return 'form-4';
  return 'form-5';
}
// Context windows come from the official model facts; vendors phrase them differently, so normalise to a token count.
function contextTokens(model: { facts?: { key: string; value: string }[] }): number | null {
  const fact = model.facts?.find((item) => item.key === 'context_window');
  if (!fact || typeof fact.value !== 'string') return null;
  const text = fact.value.replace(/,/g, '');
  const unit = /([0-9]+(?:\.[0-9]+)?)\s*([MK])\b/i.exec(text);
  if (unit) return Number(unit[1]) * (unit[2].toUpperCase() === 'M' ? 1_000_000 : 1_000);
  const plain = /([0-9]{4,})/.exec(text);
  return plain ? Number(plain[1]) : null;
}
function contextLabel(tokens: number | null): string {
  if (tokens == null) return t(locale, 'heat.not_disclosed');
  if (locale === 'zh') {
    const wan = tokens / 10_000;
    return `${Number.isInteger(wan) ? wan : wan.toFixed(1).replace(/\.0$/, '')}万`;
  }
  if (tokens >= 1_000_000) return `${(tokens / 1_000_000).toFixed(2).replace(/\.?0+$/, '')}M`;
  return `${Math.round(tokens / 1000)}K`;
}
const contextMax = Math.max(1, ...(heat?.models ?? []).map((model) => contextTokens(model) ?? 0));
function shareOf(count: number, share: number | null | undefined, models: number): number {
  const value = typeof share === 'number' ? share : (models ? count / models : 0);
  return Math.max(0, Math.min(1, value));
}
const matrixMin = 4;
const matrixModels = (heat?.models ?? []).map((model) => ({
  ...model,
  theme: resolveModelTheme(model.id, model.organization),
}));
const reportedBy = new Map(matrixModels.map((model) => [model.id, new Set(model.benchmarks ?? [])]));
const matrixRows = (heat?.ranking ?? []).filter((row) => row.count >= matrixMin).map((row) => ({
  id: row.benchmark_id,
  name: displayName(row.name),
  href: known.has(row.benchmark_id) ? page('benchmarks/' + row.benchmark_id) : '',
  count: row.count,
  cells: matrixModels.map((model) => reportedBy.get(model.id)?.has(row.benchmark_id) ?? false),
  // Version labels named by each model's official docs; a lone family name means no version was given.
  versions: matrixModels.map((model) => {
    const labels = row.versions?.[model.id] ?? [];
    return labels.length === 1 && labels[0] === row.name ? [] : labels;
  }),
}));
---
<Base title={t(locale, 'heat.title')} description={t(locale, 'heat.description')} active="heat">
  <div class="wrap page-hero">
    <h1>{t(locale, 'heat.title')}</h1>
    <p class="lede">{t(locale, 'heat.lede')}</p>
    {heat?.coverage?.interpretation_zh && <p class="disclaimer">{locale === 'zh' ? heat.coverage.interpretation_zh.replace(/\s*benchmarks?\s*/gi, '基准') : translateContent(heat.coverage.interpretation_zh, locale)}</p>}
    {heat && (
      <>
        <p class="meta-row">
          {stamp && <span>{ui.snapshot} {stamp}</span>}
          <span>{t(locale, 'home.models', { n: heat.models.length })}</span>
        </p>
        <div class="stat-row heat-stats">
          <div class="stat">
            <span>{ui.statModels}</span>
            <strong>{heat.models.length}</strong>
            <svg class="stat-viz" viewBox="0 0 120 22" preserveAspectRatio="none" aria-hidden="true">
              {(() => {
                let x = 0;
                return orgCounts.map(([org, count]) => {
                  const width = (count / Math.max(heat.models.length, 1)) * 120;
                  const theme = resolveOrgTheme(org);
                  const rect = <rect x={x} y="7" width={Math.max(width - 1.5, 1)} height="8" rx="1.5" style={theme.style} fill="var(--m-color, var(--amber))" />;
                  x += width;
                  return rect;
                });
              })()}
            </svg>
            <small class="stat-sub">{t(locale, 'heat.stat_orgs')} {orgCounts.length}</small>
          </div>
          <div class="stat">
            <span>{ui.statListed}</span>
            <strong>{nf.format(heat.ranking.length)}</strong>
            <svg class="stat-viz" viewBox="0 0 120 22" preserveAspectRatio="none" aria-hidden="true">
              {history.map((entry, index) => (
                <rect x={index * (120 / Math.max(history.length, 1)) + 1} y={21 - (entry.top.length / Math.max(...history.map((h) => h.top.length), 1)) * 18} width={120 / Math.max(history.length, 1) - 3} height={(entry.top.length / Math.max(...history.map((h) => h.top.length), 1)) * 18} rx="1.5" fill="var(--amber-tint, #efe4cc)" stroke="var(--bar, #a87408)" stroke-width="0.6" />
              ))}
            </svg>
          </div>
          <div class="stat">
            <span>{t(locale, 'heat.stat_pairs')}</span>
            <strong>{nf.format(totalMentions)}</strong>
            <svg class="stat-viz" viewBox="0 0 120 22" preserveAspectRatio="none" aria-hidden="true">
              {heat.ranking.slice(0, 40).map((row, index) => (
                <rect x={index * 3} y={21 - (row.count / Math.max(topRow?.count ?? 1, 1)) * 18} width="2.2" height={Math.max(1, (row.count / Math.max(topRow?.count ?? 1, 1)) * 18)} fill="var(--amber, #c4962a)" />
              ))}
            </svg>
          </div>
          {topRow && (
            <div class="stat stat-wide">
              <span>{t(locale, 'heat.stat_top')}</span>
              <strong class="stat-name">{displayName(topRow.name)}</strong>
              <span class="stat-meter" aria-hidden="true"><span style={`width:${Math.round((topRow.count / Math.max(heat.models.length, 1)) * 100)}%`}></span></span>
              <small class="stat-sub">{t(locale, 'heat.stat_top_of', { n: topRow.count, total: heat.models.length })}</small>
            </div>
          )}
        </div>
      </>
    )}
  </div>
  <div class="wrap">
    {heat ? (
      <>
        {matrixRows.length > 0 && (
          <section class="section" aria-labelledby="heat-matrix-title">
            <header class="flag">
              <h2 id="heat-matrix-title">{t(locale, 'heat.matrix')}</h2>
              <p>{t(locale, 'heat.matrix_note', { n: matrixMin })}</p>
            </header>
            <p class="heat-legend matrix-legend">
              <span><i class="swatch on" aria-hidden="true"></i>{t(locale, 'heat.legend_on')}</span>
              <span><i class="swatch off" aria-hidden="true"></i>{t(locale, 'heat.legend_off')}</span>
              <span class="legend-hint">{t(locale, 'heat.legend_hover')}</span>
            </p>
            <p class="index-note">{t(locale, 'heat.matrix_scroll')} {t(locale, 'heat.matrix_models_hint')}</p>
            <p class="sr-only">{t(locale, 'heat.matrix_keys')}</p>
            <div class="matrix-scroll" role="region" tabindex="0" aria-label={t(locale, 'heat.matrix_aria')}>
              <table class="matrix" id="heat-matrix" data-versions-title={t(locale, 'heat.tip_versions')} data-no-version={t(locale, 'heat.tip_no_version')}>
                <caption class="sr-only">{t(locale, 'heat.matrix_aria')}</caption>
                <thead>
                  <tr>
                    <th class="bench" scope="col"></th>
                    {matrixModels.map((model, index) => (
                      <th scope="col" data-col={index} style={model.theme.style} title={model.name}>
                        <span class="vhead">
                          <BrandLogo theme={model.theme} size={16} eager />
                          <span class="vname">{model.name}</span>
                        </span>
                      </th>
                    ))}
                    <th scope="col" class="row-total">{t(locale, 'heat.row_total')}</th>
                  </tr>
                </thead>
                <tbody>
                  {matrixRows.map((row, rowIndex) => (
                    <tr>
                      <th class="bench" scope="row">
                        {row.href ? <a href={row.href}>{row.name}</a> : row.name}
                      </th>
                      {row.cells.map((on, index) => {
                        const model = matrixModels[index];
                        const modelLabel = model?.name ?? '';
                        const theme = model?.theme;
                        const label = t(locale, on ? 'heat.cell_yes' : 'heat.cell_no', { model: modelLabel, benchmark: row.name });
                        const versions = on ? row.versions[index] ?? [] : [];
                        const aria = versions.length
                          ? t(locale, 'heat.cell_versions', { model: modelLabel, benchmark: row.name, versions: versions.join(locale === 'zh' ? '、' : ', ') })
                          : label;
                        const cellStyle = theme
                          ? `${theme.style}${theme.cellMask ? `;--m-mask:url("${asset(`logos/${theme.cellMask}`)}")` : ''}`
                          : undefined;
                        return (
                          <td data-col={index} class={on ? 'is-on' : 'is-off'} style={theme?.style}>
                            <button
                              type="button"
                              class:list={['heat-cell', on && 'on']}
                              tabindex={rowIndex === 0 && index === 0 ? 0 : -1}
                              aria-label={aria}
                              data-tip={label}
                              data-versions={on ? JSON.stringify(versions) : undefined}
                              data-col={index}
                              data-logo={theme?.logo ? asset(`logos/${theme.logo}`) : undefined}
                              data-logo-kind={theme?.logoKind ?? undefined}
                              style={cellStyle}
                            ></button>
                          </td>
                        );
                      })}
                      <td class="row-total num"><span style={`--fill:${Math.round((row.count / Math.max(matrixModels.length, 1)) * 100)}%`}>{row.count}</span></td>
                    </tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr>
                    <th class="bench" scope="row">{t(locale, 'heat.col_total')}</th>
                    {matrixModels.map((model, index) => (
                      <td data-col={index} class="col-total num" style={model.theme.style}>{model.benchmarks?.length ?? 0}</td>
                    ))}
                    <td class="row-total"></td>
                  </tr>
                </tfoot>
              </table>
            </div>
            <div id="heat-tip" class="heat-tip" role="tooltip" hidden></div>
          </section>
        )}
        {heatChart.length > 0 && (
          <section class="chart-block heat-top-board" aria-labelledby="heat-top">
            <h2 id="heat-top">{ui.topChart}</h2>
            <BarChart items={heatChart} strong />
          </section>
        )}
        <section class="section" aria-labelledby="heat-models">
          <header class="flag">
            <h2 id="heat-models">{t(locale, 'heat.models')}</h2>
            <p>{t(locale, 'heat.model_count', { n: heat.models.length })}</p>
          </header>
          <div class="table-wrap" role="region" tabindex="0" aria-label={t(locale, 'table.scroll_label')}>
            <table class="board heat-models-table">
              <thead>
                <tr>
                  <th scope="col">{ui.models}</th>
                  <th scope="col">{ui.organization}</th>
                  <th scope="col">{ui.release}</th>
                  <th scope="col">{t(locale, 'heat.col.named')}</th>
                  <th scope="col">{t(locale, 'heat.col.context')}</th>
                  <th scope="col">{ui.source}</th>
                </tr>
              </thead>
              <tbody>
                {heat.models.map((model) => {
                  const source = model.sources?.find((item) => item.url && safeUrl(item.url));
                  const mTheme = resolveModelTheme(model.id, model.organization);
                  const oTheme = model.organization ? resolveOrgTheme(model.organization) : null;
                  return (
                    <tr class="model-row" style={mTheme.style}>
                      <td class="name-cell" data-label={ui.models}>
                        <span class="model-pill" style={mTheme.style} data-model-family={mTheme.family}>
                          <BrandLogo theme={mTheme} size={15} />
                          <span class="model-name">{model.name}</span>
                        </span>
                      </td>
                      <td data-label={ui.organization}>
                        {model.organization && oTheme ? (
                          <span class="org-pill" style={oTheme.style}>
                            <BrandLogo theme={oTheme} size={14} />
                            <span>{model.organization}</span>
                          </span>
                        ) : (
                          <span class="na" title={ui.nullTip}>—</span>
                        )}
                      </td>
                      <td data-label={ui.release}>{dateStamp(model.release_date) || <span class="na" title={ui.nullTip}>—</span>}</td>
                      <td data-label={t(locale, 'heat.col.named')}>
                        <span class="score-wrap" title={String(model.benchmarks?.length ?? 0)}>
                          <span class="score-num">{model.benchmarks?.length ?? 0}</span>
                          <span class="track" aria-hidden="true"><span style={`width:${Math.round(((model.benchmarks?.length ?? 0) / namedMax) * 100)}%`}></span></span>
                        </span>
                      </td>
                      <td data-label={t(locale, 'heat.col.context')}>
                        {(() => {
                          const tokens = contextTokens(model);
                          return tokens == null
                            ? <span class="na">{contextLabel(null)}</span>
                            : <span class="ctx-cell"><span class="num">{contextLabel(tokens)}</span><span class="ctx-bar" aria-hidden="true"><span style={`width:${Math.round((tokens / contextMax) * 100)}%`}></span></span></span>;
                        })()}
                      </td>
                      <td data-label={ui.source}>{source?.url && safeUrl(source.url) ? <a href={source.url} target="_blank" rel="noopener noreferrer">{ui.open}</a> : <span class="na" title={ui.nullTip}>—</span>}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
        <section class="section" aria-labelledby="heat-rank">
          <header class="flag">
            <h2 id="heat-rank">{t(locale, 'heat.by_count')}</h2>
            <p>{t(locale, 'heat.share_note')}</p>
          </header>
          <form id="heat-form" class="board-toolbar" role="search" action={page('frontier-heat')} method="get">
            <label class="sr-only" for="heat-q">{ui.heatSearch}</label>
            <input id="heat-q" class="search" type="search" placeholder={ui.heatSearch} autocomplete="off" enterkeyhint="search" />
            <label class="sr-only" for="heat-domain">{ui.colDomain}</label>
            <select id="heat-domain">
              <option value="">{ui.allDomains}</option>
              {domains.map((domain) => <option value={sectionSlug(domain)}>{sectionLabel(domain, locale)}</option>)}
            </select>
            <p id="heat-count" class="result-count" data-showing={ui.showing} data-unit={ui.rows} aria-live="polite"></p>
          </form>
          <p id="heat-empty" class="empty" hidden>{ui.emptyFilter}</p>
          <div class="board-scroll grow-root">
            <table class="board heat-rank-table">
              <caption class="sr-only">{t(locale, 'heat.title')}</caption>
              <thead>
                <tr>
                  <th class="rank-col" scope="col">{ui.colRank}</th>
                  {showMovement && <th scope="col">{t(locale, 'heat.col.change')}</th>}
                  <th class="name-col" scope="col">{ui.colName}</th>
                  <th scope="col">{ui.colDomain}</th>
                  <th scope="col">{ui.reported}</th>
                  <th scope="col">{ui.share}</th>
                  {showSpark && <th scope="col" title={t(locale, 'heat.form_note', { n: formHistory.length })}>{t(locale, 'heat.col.form')}</th>}
                  <th scope="col">{ui.reportedModels}</th>
                </tr>
              </thead>
              <tbody>
                {heat.ranking.map((row) => {
                  const arrow = rankArrow(row.rank_change);
                  const share = shareOf(row.count, row.share, heat.models.length);
                  const sharePct = Math.round(share * 100);
                  const podium = 3 >= row.rank ? 'podium podium-' + row.rank : '';
                  const search = [row.name, row.benchmark_id, sectionLabel(row.domain, locale)].join(' ').toLowerCase();
                  return (
                    <tr class={podium} data-heat-row data-domain={sectionSlug(row.domain)} data-search={search}>
                      <td class="rank-cell" data-label={ui.colRank}><span class="rank-no">{row.rank}</span></td>
                      {showMovement && (
                        <td class="chg-cell" data-label={t(locale, 'heat.col.change')}>
                          {row.rank_change === 'new' ? <span class="move-chip move-chip-new" title={arrow.label}>{t(locale, 'rank.new_mark')}</span> : <span class:list={['move-chip', typeof row.rank_change === 'number' && row.rank_change > 0 ? 'move-chip-up' : typeof row.rank_change === 'number' && row.rank_change < 0 ? 'move-chip-down' : 'move-chip-same']} title={arrow.label}>{arrow.mark}</span>}
                        </td>
                      )}
                      <td class="name-cell" data-label={ui.colName}>
                        {known.has(row.benchmark_id) ? <a href={page('benchmarks/' + row.benchmark_id)}>{displayName(row.name)}</a> : displayName(row.name)}
                      </td>
                      <td class="domain-cell" data-label={ui.colDomain}>{row.domain ? <span class="domain-tag" style={sectionStyle(row.domain)}>{sectionLabel(row.domain, locale)}</span> : <span class="na" title={ui.nullTip}>—</span>}</td>
                      <td class="num count-cell" data-label={ui.reported}>{row.count}</td>
                      <td class="share-cell" data-label={ui.share}>
                        <span class="score-wrap" title={sharePct + '%'}>
                          <span class="score-num">{sharePct}%</span>
                          <span class="track" aria-hidden="true"><span class="grow" style={'width:' + sharePct + '%'}></span></span>
                        </span>
                      </td>
                      {showSpark && (
                        <td class="form-cell" data-label={t(locale, 'heat.col.form')}>
                          <ol class="form-strip">
                            {formOf(row.benchmark_id).map((step) => {
                              const tip = step.rank == null ? t(locale, 'heat.form_out', { date: step.date }) : t(locale, 'heat.form_rank', { date: step.date, n: step.rank });
                              return <li class={formTier(step.rank)} title={tip}><span class="sr-only">{tip}</span><span aria-hidden="true">{step.rank == null ? '' : step.rank}</span></li>;
                            })}
                          </ol>
                        </td>
                      )}
                      <td class="models-cell" data-label={ui.reportedModels}>
                        <details>
                          <summary>
                            <span>{t(locale, 'home.models', { n: (row.models ?? []).length })}</span>
                            <span class="model-beads" aria-hidden="true">
                              {(row.models ?? []).map((id) => {
                                const mTheme = resolveModelTheme(id);
                                return (
                                  <span class="model-bead" style={mTheme.style} title={modelName.get(id) ?? id}>
                                    <BrandLogo theme={mTheme} size={12} />
                                  </span>
                                );
                              })}
                            </span>
                          </summary>
                          <ul class="doc-list model-pill-list">
                            {(row.models ?? []).map((id) => {
                              const label = modelName.get(id) ?? id;
                              const mTheme = resolveModelTheme(id);
                              return (
                                <li class="model-pill model-pill-sm" style={mTheme.style} data-model-family={mTheme.family}>
                                  <BrandLogo theme={mTheme} size={14} />
                                  <span class="model-name">{label}</span>
                                </li>
                              );
                            })}
                          </ul>
                        </details>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <div class="pager-bar">
            <button type="button" class="pager-btn" id="heat-prev">{ui.prev}</button>
            <span id="heat-page"></span>
            <button type="button" class="pager-btn" id="heat-next">{ui.next}</button>
          </div>
        </section>
        {movers.length > 0 && (
          <section class="section" aria-labelledby="heat-movers">
            <header class="flag"><h2 id="heat-movers">{t(locale, 'heat.movers')}</h2><p>{t(locale, 'heat.movers_note')}</p></header>
            <ol class="mover-grid">
              {movers.map((row, index) => {
                const href = known.has(row.id) ? page('benchmarks/' + row.id) : '';
                const now = (heat?.ranking ?? []).find((item) => item.benchmark_id === row.id);
                const Tag = href ? 'a' : 'span';
                return (
                  <li>
                    <Tag class="mover-card" href={href || undefined}>
                      <span class="mover-place">{index + 1}</span>
                      <span class="mover-name">{displayName(row.name)}</span>
                      <span class="move-chip move-chip-up" title={t(locale, 'rank.up', { n: row.delta ?? 0 })}>{t(locale, 'rank.up_mark', { n: row.delta ?? 0 })}</span>
                      {now && <span class="mover-now">{ui.colRank} {now.rank}</span>}
                    </Tag>
                  </li>
                );
              })}
            </ol>
          </section>
        )}
        <script>
          import { mountHeatBoard } from '../scripts/heat-board.ts';
          mountHeatBoard();
        </script>
      </>
    ) : (
      <p class="pending-data">{t(locale, 'home.pending_data')}</p>
    )}
  </div>
</Base>
