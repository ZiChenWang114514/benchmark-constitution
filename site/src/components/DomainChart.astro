---
import { SECTION_PALETTES, sectionStyle } from '../lib/format';

const FALLBACK_PALETTES = Object.values(SECTION_PALETTES);

interface Item {
  label: string;
  count: number;
  href: string;
  slug: string;
  section?: string;
}
interface Props {
  items: Item[];
  title: string;
  aria: string;
  segment: string;
}
const { items, title, aria, segment } = Astro.props;
const tiles = items.map((item, index) => ({
  ...item,
  style: item.section
    ? sectionStyle(item.section)
    : FALLBACK_PALETTES[index % FALLBACK_PALETTES.length].style,
  text: segment.replace('{label}', item.label).replace('{n}', String(item.count)),
}));
---
<figure class="domain-chart">
  <figcaption>{title}</figcaption>
  <div class="treemap" role="group" aria-label={aria}>
    {tiles.map((item) => (
      <a href={item.href} data-domain-link={item.slug} aria-label={item.text} style={`flex-grow:${item.count};${item.style}`}>
        <span>{item.label}</span>
        <b class="num">{item.count}</b>
      </a>
    ))}
  </div>
</figure>
